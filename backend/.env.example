# 应用基本配置
APP_NAME=Crop Guard Platform
APP_VERSION=1.0.0
DEBUG=true

# PostgreSQL数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=crop_user
DB_PASSWORD=crop_password
DB_NAME=crop_guard_db

# Redis缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO对象存储配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=crop-guard-bucket
MINIO_SECURE=false

# YOLO检测模型配置
YOLO_MODEL_PATH=yolo11n.pt
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45

# 文件存储配置
UPLOAD_DIR=static/uploads
RESULT_DIR=static/results
