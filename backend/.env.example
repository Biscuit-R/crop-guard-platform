# 复制成 .env 后按需修改。.env 不进版本库。
# 字段名与 app/core/config.py 的 Settings 一一对应。

APP_NAME=crop-guard-platform
DEBUG=false

# PostgreSQL（容器内互访用服务名 + 容器内端口，见 docker-compose.yml）
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=crop_user
POSTGRES_PASSWORD=crop_password
POSTGRES_DB=crop_guard_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# MinIO
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=crop-guard
MINIO_SECURE=false

# HuggingFace 镜像源（BGE 模型下载用；HF 直连不通，重建索引前必须设）
# 用法：HF_ENDPOINT=https://hf-mirror.com uv run python -m app.rag.rebuild_index
HF_ENDPOINT=https://hf-mirror.com

# DeepSeek（RAG 问答生成用，见 docs/decisions.md D7；key 自行申请贴入 .env）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 检索阈值三档（D10）—— 2026-10-08 口语化评测集重测确认维持（详见 config.py 注释）
RETRIEVAL_HIGH=0.75
RETRIEVAL_LOW=0.60

# 账号（D6）。JWT_SECRET 上生产前必须换掉（阶段 5 遗留清单）
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=720
LOGIN_MAX_ATTEMPTS=5

# 检测（YOLO 权重路径相对 backend/；上传上限先于内容嗅探检查 → 超限 413）
MODEL_PATH=models/model_102.pt
MAX_UPLOAD_MB=50

# LLM 超时（openai SDK 默认 600s 会拖死请求；超时 → LLMError → fail-open）
DEEPSEEK_TIMEOUT=30.0
